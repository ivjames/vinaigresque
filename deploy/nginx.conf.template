# nginx vhost for Vinaigresque — plain static site, no app process.
# Installed by `vinaigresque setup` as the vhost for this site. The
# @@SERVER_NAMES@@ and @@ROOT@@ placeholders are filled in by sed AT SETUP TIME on the droplet —
# a deliberately different syntax from the scaffold's own double-underscore
# placeholders, so the two substitution passes can't eat each other's markers.
#
# certbot --nginx adds the :443 block + redirect afterwards, copying this
# server block — so everything here rides along into the TLS vhost.
#
# Note on add_header inheritance: a location{} that sets its own add_header
# stops inheriting the server-level ones, so the shared security snippet is
# re-included in every location that adds Cache-Control.

server {
    listen 80;
    listen [::]:80;
    # Apex site: the bare domain and its www alias are served by one block,
    # matching the platform's `provision-site @` shape (no www -> apex
    # redirect; the cert simply covers both names). Filled in at setup time
    # by the CLI, which drops the www half under --no-www.
    server_name @@SERVER_NAMES@@;

    root @@ROOT@@;
    index index.html;

    include snippets/lab980-security-headers.conf;

    # Always revalidate the entry page, so a deploy (git reset to origin/main)
    # is live on the next visit rather than after a cache expiry nobody can
    # see. "/" internally redirects here via the index directive and picks up
    # these headers. Hashed/versioned assets can be cached hard alongside this.
    location = /index.html {
        include snippets/lab980-security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # The web root is the git checkout — keep repo plumbing and docs private.
    # NOT /.well-known: certbot's HTTP-01 challenge lives there, and denying
    # it breaks both the setup run's certbot and every renewal afterwards.
    # This is the lookahead form bin/fix-dotgit swept across the box.
    location ~ /\.(?!well-known) { deny all; return 404; }
    location ~* \.md$ { deny all; }

    # deploy/ holds this template and its neighbours — build plumbing, not
    # content, and nothing the web root needs to answer for.
    #
    # ^~ rather than a regex, because a prefix match with ^~ stops regex
    # evaluation: it therefore outranks the \.md$ rule above, and everything
    # under deploy/ answers the same way. A regex form here would leave
    # deploy/README.md answering 403 while deploy/nginx.conf.template answers
    # 404 — denied either way, but for two different-looking reasons.
    #
    # The trailing slash carries weight: plain `^~ /deploy` would also swallow
    # a future /deployment-notes.html, so the bare path gets its own exact
    # match instead of being folded in. Without it /deploy still 301s to
    # /deploy/ and lands on the 404, which works but advertises the directory.
    #
    # 404 rather than 403, matching the dotfile rule: no reason to confirm
    # what is there.
    location = /deploy   { return 404; }
    location ^~ /deploy/ { deny all; return 404; }
}
